# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.

# ---------------------------------------------------------------------------
# Frontend (read by Vite at build time)
# ---------------------------------------------------------------------------
# Base URL of the backend API. For local docker-compose, leave as the relative
# path so requests are proxied through nginx. For a deployed frontend pointing
# at a remote backend, set the full URL (e.g. https://api.example.com/api).
VITE_API_URL=/api

# ---------------------------------------------------------------------------
# Backend (read by the Express server in `server/`)
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# REQUIRED in production. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Origin allowed by CORS. Set to wherever the frontend is served from.
FRONTEND_URL=http://localhost:5173

# Database connection — use either DATABASE_URL or the individual DB_* vars.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/10xlegal
DB_HOST=localhost
DB_PORT=5432
DB_NAME=10xlegal
DB_USER=postgres
DB_PASSWORD=postgres
